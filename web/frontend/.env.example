# Адрес API веб-карты, каким его видит браузер.
VITE_API_URL=http://localhost:8000
# Растровая подложка. tile.openstreetmap.org — только для разработки и демонстраций
# (см. правила OSMF Tile Usage Policy); для внешнего показа нужен свой или платный сервер.
VITE_BASEMAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors
